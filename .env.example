# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-password

# Email Settings
EMAIL_FROM="Il Tuo Servizio" <noreply@example.com>

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=1000
RETRY_BACKOFF=2

# Timeout
EMAIL_TIMEOUT=10000

# Logging
LOG_ERRORS=true
LOG_FILE=./logs/email-errors.log
